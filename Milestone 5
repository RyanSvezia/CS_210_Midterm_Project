#include "Timer.h"
#include <iostream>
#include <vector>
#include <string>
using namespace std;

vector<School> readSchoolData(const string& filename) {
  vector<School> schools;
  vector<vector<string>> rows = CSVReader::readCSV(filename);

  for (const auto& row : rows) {
    if (row.size() >= 5) {
      schools.emplace_back(row[0], row[1], row[2], row[3], row[4]);
    }
  }
  return schools;
}

void schoolDataStructures(const string& filename) {
  string deleteName = "ST ANNE COMM HIGH SCHOOL";
  string findName = "BRADLEY UNIVERSITY";
  auto data = readSchoolData(filename);
  if (data.empty()) {
    cerr << "No data loaded from " << filename << "\n";
    return;
  }
  
  Timer t;
  SchoolList list;
  t.start();
  for (const auto& school : data) list.insertLast(school);
  t.stop();
  double listInsertTime = t.get_time();

  t.start();
  list.deleteByName(deleteName);
  t.stop();
  double listDeleteTime = t.get_time();

  t.start();
  list.findByName(findName);
  t.stop();
  double listFindTime = t.get_time();

  SchoolBST bst;
  t.start();
  for (const auto& school : data) bst.insert(school);
  t.stop();
  double bstInsertTime = t.get_time();

  t.start();
  bst.deleteByName(deleteName);
  t.stop();
  double bstDeleteTime = t.get_time();

  t.start();
  bst.findByName(findName);
  t.stop();
  double bstFindTime = t.get_time();

  SchoolHashTable hashTable;
  t.start();
  for (const auto& school : data) hashTable.insert(school);
  t.stop();
  double hashInsertTime = t.get_time();

  t.start();
  hashTable.deleteByName(deleteName);
  t.stop();
  double hashDeleteTime = t.get_time();

  t.start();
  hashTable.findByName(findName);
  t.stop();
  double hashFindTime = t.get_time();

  ofstream outFile("school_results.csv", ios::app);
  if (!outFile.is_open()) {
    cerr << "Failed to open school_results.csv\n";
    return;
  } else {
    outFile << filename << "," << listInsertTime << "," << bstInsertTime << "," << hashInsertTime << "," << listDeleteTime << ","
    << bstDeleteTime << "," << hashDeleteTime << "," << listFindTime << "," << bstFindTime << "," << hashFindTime << "\n";
    outFile.close();
  }
}
int main() {
  vector<string> filenames = {
    "Illinois_Schools.csv",
    "USA_Schools.csv"
};

  for (const auto& file : filenames) {
    schoolDataStructures(file);
  }

  cout << "Processes complete. Results saved to school_results.csv\n";
  return 0;
}
